# Copy to .env for local development. Values below work with the repo's
# docker-compose services out of the box; every variable listed here is
# required unless marked optional.

# Postgres (docker-compose: postgres service)
DB_URI=postgres://synctex:synctex@localhost:5432/synctex

# Auth secret — generate a real one with: openssl rand -hex 32
JWT_KEY=dev-only-change-me

# HTTP
# Optional; defaults to 8080.
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
# Use true when the app is served over HTTPS.
COOKIE_SECURE=false

# Optional comma-separated proxy IPs or CIDRs. Empty means trust no proxy.
TRUSTED_PROXIES=

# S3-compatible object storage (docker-compose: minio service)
B2_ENDPOINT=http://localhost:9000
B2_ACCESS_KEY=synctex
B2_SECRET_KEY=synctex-dev
B2_REGION=us-east-1
B2_BUCKET=synctex-dev

# SMTP for workspace invitations (optional in dev; invites log errors without it)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
