                },
                "title": {
                    "type": "string"
                },
                "workspace_id": {
                    "type": "string"
                }
            }
        },
        "snapshotSchemas.UpsertSnapshotRequest": {
            "type": "object",
            "required": [
                "state"
            ],
            "properties": {
                "state": {
                    "description": "base64",
                    "type": "string"
                }
            }
        },
        "workspaceSchemas.AddMemberRequest": {
            "type": "object",
            "required": [
                "role",
                "user_id"
